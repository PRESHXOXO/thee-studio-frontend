# The polished Studio UI runs without Supabase in local preview mode.
# Configure both values to enable cloud authentication, persistence, private
# storage, and production provider Edge Functions.
VITE_SUPABASE_URL=https://yourprojectref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Local browser-only accounts are for development and automated tests only.
# Keep this false in preview/production deployments.
VITE_ALLOW_LOCAL_MODE=false
